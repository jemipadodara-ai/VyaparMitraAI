rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Merchants / Business profiles
    match /users/{userId} {
      allow read, write: if true;

      // Merchant tasks and orders subcollection
      match /tasks/{taskId} {
        allow read, write: if true;
      }
    }

    // Top-level tasks collection fallback
    match /tasks/{taskId} {
      allow read, write: if true;
    }
  }
}
